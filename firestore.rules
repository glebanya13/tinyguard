rules_version = '2';
// Bimbleguard on the Firebase Spark plan: NO Cloud Functions. Everything the server
// must guarantee is enforced here; the client is not a security boundary.
//
// Players sign in anonymously (guest) through Firebase Auth and may only touch
// their own documents:
//   users/{uid}            private profile: progression, settings, onboarding flags
//   publicProfiles/{uid}   public nickname (readable by signed-in players)
//   nicknames/{normalized} uniqueness index {uid, nickname, createdAt}; create-only
//   nicknameTrace/{uid}    when the nickname last changed; survives profile deletion
//   runs/{uid}             start of the current endless run (server time)
//   leaderboards/level_N/scores/{uid}   endless-siege records, only upwards and
//                          not faster than the wave clock allows (see below)
//   saves/{uid}            legacy cloud save of older app versions
//
// Nickname reservation and change are ONE atomic commit from the client
// (documents:commit): create nicknames/{new} (fails if it exists, a taken name
// cannot be overwritten), delete nicknames/{old}, write publicProfiles/{uid}.
// The rules read the state after the commit (existsAfter/getAfter), so a player
// can hold exactly one name and the three documents always agree.
// Policy twin: scripts/nickname_rules.gd (checked against tests/nickname_cases.json
// in firebase/rules-tests). See docs/ACCOUNTS.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- nickname policy -------------------------------------------------

    // Latin letters (incl. U+00C0..U+017E without U+00D7, U+00F7, U+0130),
    // Cyrillic (U+0401..U+045F without U+040D) and digits.
    function nickChars() {
      return '0-9A-Za-z\\x{C0}-\\x{D6}\\x{D8}-\\x{F6}\\x{F8}-\\x{12F}\\x{131}-\\x{17E}\\x{401}-\\x{40C}\\x{40E}-\\x{45F}';
    }

    // 3..16 characters; one space or underscore only between letters/digits.
    function validNickname(n) {
      return n is string
        && n.size() >= 3 && n.size() <= 16
        && n.matches('^[' + nickChars() + ']+([ _][' + nickChars() + ']+)*$');
    }

    // The uniqueness key (lower case, "ё" -> "е", space -> "_"). Rules' lower()
    // only knows ASCII, so the key is not computed but VERIFIED: it has no upper
    // case letters (\\p{Lu}) and equals the nickname case-insensitively (RE2 (?i)).
    // The client computes the same key in NicknameRules.normalize().
    function keyMatches(n, key) {
      return key.matches('^[' + nickChars() + ']+(_[' + nickChars() + ']+)*$')
        && !key.matches('.*\\p{Lu}.*')
        && n.replace('Ё', 'Е').replace('ё', 'е').replace(' ', '_')
            .matches('(?i)^' + key + '$');
    }

    function reservedNick(key) {
      return key in ['admin', 'administrator', 'moderator', 'support', 'system',
                     'tinyguard', 'bimbleguard', 'рыцарь', 'админ', 'администратор',
                     'модератор', 'поддержка'];
    }

    function nameDocAfter(key) {
      return /databases/$(database)/documents/nicknames/$(key);
    }

    function profileDocAfter(uid) {
      return /databases/$(database)/documents/publicProfiles/$(uid);
    }

    function traceDoc(uid) {
      return /databases/$(database)/documents/nicknameTrace/$(uid);
    }

    // ---- users/{uid}: private profile ------------------------------------

    function validProgression(p) {
      return p is map
        && p.keys().hasOnly(['unlocked', 'stars', 'endless', 'perks'])
        && p.unlocked is int && p.unlocked >= 1 && p.unlocked <= 100
        && p.stars is map && p.stars.size() <= 100
        && p.endless is map && p.endless.size() <= 100
        && p.perks is map && p.perks.size() <= 32;
    }

    function validUser(d) {
      return d.keys().hasOnly(['schemaVersion', 'createdAt', 'updatedAt',
                               'onboardingCompleted', 'tutorialVersionCompleted',
                               'progression', 'settings'])
        && d.schemaVersion is int && d.schemaVersion >= 1 && d.schemaVersion <= 1000
        && d.updatedAt == request.time
        && d.onboardingCompleted is bool
        && d.tutorialVersionCompleted is int
        && d.tutorialVersionCompleted >= 0 && d.tutorialVersionCompleted <= 1000
        && validProgression(d.progression)
        && d.settings is map && d.settings.keys().hasOnly(['sound'])
        && d.settings.get('sound', true) is bool;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        // A newer app's document is never rewritten by an older schema.
        && request.resource.data.schemaVersion >= resource.data.get('schemaVersion', 0);
      allow delete: if isOwner(uid); // account deletion
    }

    // ---- publicProfiles/{uid}: the public nickname -----------------------

    function validPublicProfile(d, uid) {
      return d.keys().hasOnly(['nickname', 'nicknameNormalized', 'createdAt',
                               'nicknameChangedAt'])
        && validNickname(d.nickname)
        && keyMatches(d.nickname, d.nicknameNormalized)
        && !reservedNick(d.nicknameNormalized)
        && d.nicknameChangedAt == request.time
        // The same commit stamps the trace document (see nicknameTrace below), so a
        // profile cannot be (re)created without moving the 24 hour clock.
        && existsAfter(traceDoc(uid))
        && getAfter(traceDoc(uid)).data.changedAt == request.time
        // The same commit creates the matching index document for this player.
        && existsAfter(nameDocAfter(d.nicknameNormalized))
        && getAfter(nameDocAfter(d.nicknameNormalized)).data.uid == uid;
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(uid)
        && validPublicProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validPublicProfile(request.resource.data, uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.nicknameNormalized != resource.data.nicknameNormalized
        // One change per 24 hours (the first reservation is free).
        && request.time >= resource.data.nicknameChangedAt + duration.value(24, 'h')
        // The old name is released in the same commit.
        && !existsAfter(nameDocAfter(resource.data.nicknameNormalized));
      // Only together with deleting the index document.
      allow delete: if isOwner(uid)
        && !existsAfter(nameDocAfter(resource.data.nicknameNormalized));
    }

    // ---- nicknameTrace/{uid}: the 24 hour clock that outlives the profile ---
    // Deleting publicProfiles/{uid} (allowed, it is part of account deletion) used
    // to reset the limit: the next reservation looked like the free first one. The
    // trace keeps the time of the last change. It is written in every reservation
    // commit and may only be rewritten or deleted once 24 hours have passed, so
    // delete-and-recreate gains nothing. Creating the first one is free.
    // Deleting an account within 24 hours of a nickname change leaves the trace
    // (uid + time, no name) behind; the Auth user is gone, so it is inert.

    match /nicknameTrace/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && validTrace(request.resource.data);
      allow update: if isOwner(uid) && validTrace(request.resource.data)
        && request.time >= resource.data.changedAt + duration.value(24, 'h');
      allow delete: if isOwner(uid)
        && request.time >= resource.data.changedAt + duration.value(24, 'h');
    }

    function validTrace(d) {
      return d.keys().hasOnly(['changedAt']) && d.changedAt == request.time;
    }

    // ---- runs/{uid}: when the current endless run started ------------------
    // The client writes it (server time) when an endless run begins; a record is
    // accepted only if enough real time has passed since (leaderboards below).
    // startedAt can only be "now", never backdated.

    match /runs/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['level', 'startedAt'])
        && request.resource.data.level is string
        && request.resource.data.level.matches('^level_[0-9]{1,3}$')
        && request.resource.data.startedAt == request.time;
      allow delete: if isOwner(uid); // account deletion
    }

    // ---- nicknames/{normalized}: uniqueness index, create-only -----------

    match /nicknames/{key} {
      // Lets the client tell "taken" from other refusals (the uid is public anyway).
      allow get: if signedIn();
      allow list: if false;
      // Creating over an existing document is an update, which is never allowed:
      // a taken name cannot be created again and cannot be taken over.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validNickname(request.resource.data.nickname)
        && keyMatches(request.resource.data.nickname, key)
        && !reservedNick(key)
        && request.resource.data.createdAt == request.time
        // The same commit points this player's public profile at the name...
        && getAfter(profileDocAfter(request.auth.uid)).data.nicknameNormalized == key;
      allow update: if false;
      // Only the owner, and only while the profile no longer uses the name.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(profileDocAfter(request.auth.uid))
            || getAfter(profileDocAfter(request.auth.uid)).data.nicknameNormalized != key);
    }

    // ---- leaderboards -----------------------------------------------------

    // Waves run on a fixed clock: wave N starts first_delay + (N-1)*wave_duration
    // = N*30 game seconds after the run begins (resources/levels.json; checked by
    // tools/validate_project.py) and a wave is "cleared" after it started. The
    // game can run at x2, so at least N*15 real seconds pass. A record of wave N
    // must therefore arrive >= (N-1)*15 s (15 s grace for the run-start request
    // and network delay) after runs/{uid}.startedAt. This is a LOWER bound only: it
    // makes a faked record cost real time, it does not prove the game was played.
    function minRunSeconds(wave) {
      return (wave - 1) * 15;
    }

    function runAllows(level, uid, wave) {
      let run = /databases/$(database)/documents/runs/$(uid);
      return exists(run)
        && get(run).data.level == level
        && request.time >= get(run).data.startedAt + duration.value(minRunSeconds(wave), 's');
    }

    function validScoreBase(level, uid) {
      return isOwner(uid)
        && level.matches('^level_[0-9]{1,3}$')
        && request.resource.data.keys().hasOnly(['name', 'wave', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 16
        // Only the reserved nickname, or the anonymous name.
        && (request.resource.data.name == 'Рыцарь'
            || request.resource.data.name
               == get(/databases/$(database)/documents/publicProfiles/$(uid)).data.nickname)
        && request.resource.data.wave is int
        && request.resource.data.wave > 0
        && request.resource.data.wave < 5000
        && request.resource.data.updated is timestamp;
    }

    match /leaderboards/{level}/scores/{uid} {
      allow read: if true;
      // A new record: strictly higher, stamped with the server time, and not
      // faster than the wave clock.
      allow create: if validScoreBase(level, uid)
        && request.resource.data.updated == request.time
        && runAllows(level, uid, request.resource.data.wave);
      allow update: if validScoreBase(level, uid)
        && (
          (request.resource.data.wave > resource.data.wave
           && request.resource.data.updated == request.time
           && runAllows(level, uid, request.resource.data.wave))
          // Renaming the entry after a nickname change: wave and time untouched.
          || (request.resource.data.wave == resource.data.wave
              && request.resource.data.updated == resource.data.updated));
      allow delete: if isOwner(uid); // account deletion
    }

    // Cloud saves of older app versions (whole progress file as text). Kept
    // readable for migration into users/{uid}; the new client deletes it after
    // migrating (it may contain a plain-text session token from old versions).
    match /saves/{uid} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['progress'])
        && request.resource.data.progress is string
        && request.resource.data.progress.size() < 20000;
    }
  }
}
