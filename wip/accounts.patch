     }
+
+    // Cloud saves of older app versions (whole progress file as text). Kept
+    // readable for migration into users/{uid}; the new client deletes it after
+    // migrating (it may contain a plain-text session token from old versions).
     match /saves/{uid} {
-      allow read: if request.auth != null && request.auth.uid == uid;
-      allow write: if request.auth != null
-        && request.auth.uid == uid
+      allow read, delete: if isOwner(uid);
+      allow write: if isOwner(uid)
         && request.resource.data.keys().hasOnly(['progress'])
+        && request.resource.data.progress is string
         && request.resource.data.progress.size() < 20000;
     }
   }
