+func _test_online_sync() -> void:
+	_clean()
+	# An old save with a plain-text session and a legacy cloud save.
+	var cfg: ConfigFile = LevelCatalog.data()
+	cfg.set_value("online", "uid", "uid1")
+	cfg.set_value("online", "refresh_token", "OLD-PLAIN-RT")
+	cfg.set_value("progress", "stars_1", 2)
+	LevelCatalog.commit()
+	var fake := FakeFirebase.new()
+	var legacy := ConfigFile.new()
+	legacy.set_value("progress", "stars_2", 3)
+	legacy.set_value("progress", "unlocked", 3)
+	fake.legacy_text = legacy.encode_to_text()
+	var online: Node = _configured_online(fake)
+	await online.start()
+	var text: String = FileAccess.get_file_as_string(SAVE)
+	check(
+		not "OLD-PLAIN-RT" in text and not "[online]" in text,
+		"plain-text token removed from the save"
+	)
+	check(
+		SessionStore.load_session().get("uid", "") == "uid1",
+		"old session moved to the encrypted store"
+	)
+	check(LevelCatalog.stars(2) == 3 and LevelCatalog.stars(1) == 2, "legacy cloud save merged")
+	check(
+		fake.commits.size() == 1 and fake.legacy_text == "", "profile written, legacy save deleted"
+	)
+	var write: Dictionary = fake.commits[0]
+	check(write["currentDocument"] == {"exists": false}, "create is conditional (exists=false)")
+	check(
+		(
+			write["updateMask"]["fieldPaths"].size() == PlayerProfile.SYNC_KEYS.size()
+			and not "nickname" in write["update"]["fields"]
+		),
+		"client writes only its own fields"
+	)
+	check(online.sync_state() == "synced", "state: synced")
+	var r: Dictionary = await online.sync_now()
+	check(r["ok"] and fake.commits.size() == 1, "nothing changed -> no write")
+
+	# Another device wrote in between: the conditional write fails, read again.
+	LevelCatalog.complete(1, 3)
+	check(online.sync_state() == "pending", "local change -> pending")
+	fake.fail_commits = 1
+	r = await online.sync_now()
+	check(r["ok"] and fake.commits.size() == 2, "precondition failure -> merge again and write")
+	check(
+		LevelCatalog.stars(4) == 3 and LevelCatalog.unlocked() == 5, "other device's progress kept"
+	)
+	check(
+		fake.commits[1]["currentDocument"].has("updateTime"), "update is conditional (updateTime)"
+	)
+
+	fake.offline = true
+	LevelCatalog.complete(3, 3)
+	r = await online.sync_now()
+	check(not r["ok"] and online.sync_state() == "offline", "offline -> not synced, local kept")
+	check(LevelCatalog.stars(3) == 3, "offline play stays local")
+	fake.offline = false
+	r = await online.sync_now()
+	check(r["ok"] and online.sync_state() == "synced", "synced once back online")
+
+	fake.users_doc = {"schemaVersion": 7}
+	r = await online.sync_now()
+	check(
+		r["error"] == "newer" and online.sync_state() == "newer",
+		"newer cloud schema not overwritten"
+	)
+	fake.users_doc = null
+
+
+func _test_nickname_and_delete() -> void:
+	_clean()
+	var fake := FakeFirebase.new()
+	fake.taken = ["бобр"]
+	var online: Node = _configured_online(fake)
+	await online.start()
+	var concurrent: Array = []
+	var go := func(name: String) -> void: concurrent.append(await online.reserve_nickname(name))
+	go.call("Бобр")
+	go.call("Бобр")
+	for i in 20:
+		await process_frame
+	var reasons: Array = concurrent.map(func(x: Dictionary) -> String: return x["reason"])
+	check("busy" in reasons and "taken" in reasons, "double submit blocked")
+	check(PlayerProfile.local()["nickname"] == "", "taken name never stored silently")
+	var r: Dictionary = await online.reserve_nickname("Ёжик")
+	check(r["ok"] and r["reason"] == "reserved", "name reserved on the server")
+	check(PlayerProfile.local()["nicknameVerified"], "reserved name is verified")
+	fake.offline = true
+	r = await online.reserve_nickname("Сова")
+	check(r["reason"] == "offline" and r["saved_locally"], "offline: name kept on the device")
+	check(
+		(
+			PlayerProfile.local()["nickname"] == "Сова"
+			and not PlayerProfile.local()["nicknameVerified"]
+		),
+		"offline name is unverified"
+	)
+	fake.offline = false
+	fake.taken = ["сова"]
+	await online.sync_now()
+	check(PlayerProfile.local()["nicknameConflict"], "taken at the next sync -> conflict flag")
+	check(
+		Onboarding.route(PlayerProfile.local()) == Onboarding.Route.NICKNAME,
+		"conflict -> ask again"
+	)
+
+	var callable_error: Dictionary = FirestoreClient.parse_callable_reply(
+		{
+			"ok": false,
+			"code": 429,
+			"json":
+			{"error": {"status": "RESOURCE_EXHAUSTED", "details": {"reason": "rate_limited"}}}
+		}
+	)
+	check(callable_error["reason"] == "rate_limited", "callable error reason parsed")
+	check(
+		(
+			FirestoreClient.parse_callable_reply({"ok": false, "code": 404, "json": null})["reason"]
+			== "unavailable"
+		),
+		"function not deployed -> unavailable"
+	)
+
+	r = await online.delete_account()
+	check(r["ok"] and r["scope"] == "cloud", "account deleted through deleteAccount")
+	check(
+		not FileAccess.file_exists(SAVE) and not FileAccess.file_exists(SESSION), "local data wiped"
+	)
+	check(
+		Onboarding.route(PlayerProfile.local()) == Onboarding.Route.NICKNAME,
+		"after deletion: fresh start"
+	)
+	online.setup("", "", "europe-west1", HttpTransport.new())
diff --git a/tests/test_tutorial.gd b/tests/test_tutorial.gd
new file mode 100644
index 0000000..2a3bcec
--- /dev/null
+++ b/tests/test_tutorial.gd
@@ -0,0 +1,129 @@
+extends SceneTree
+## Tutorial on level 1, advanced by the real game actions (wood from the hero,
+## gold from kills, selecting a slot and building through BuildManager, walking,
+## the whirlwind, a real wave, an upgrade) and the wave clock it holds.
+## A normal level 1 has no tutorial and keeps its first delay.
+## godot --headless --fixed-fps 60 --path . --script res://tests/test_tutorial.gd
+
+const SAVE := "user://test_tutorial.cfg"
+
+var fails := 0
+
+
+func check(c: bool, w: String) -> void:
+	print("  ok   " if c else "  FAIL ", w)
+	if not c:
+		fails += 1
+
+
+func _initialize() -> void:
+	LevelCatalog.save_path = SAVE
+	LevelCatalog.erase_all()
+	_run.call_deferred()
+
+
+func _frames(n: int) -> void:
+	for i in n:
+		await process_frame
+
+
+func _run() -> void:
+	Onboarding.set_local_nickname("Тестер", "тестер", false)
+	check(Onboarding.route(PlayerProfile.local()) == Onboarding.Route.TUTORIAL, "route: tutorial")
+	Onboarding.start_tutorial(self)
+	await _frames(10)
+	var main: Node = current_scene
+	var tutorial := main.get_node_or_null("Tutorial") as Tutorial
+	check(tutorial != null, "tutorial overlay on level 1 in tutorial mode")
+	if tutorial == null:
+		_finish()
+		return
+	var gs: GameState = main.get_node("GameState")
+	var wm: WaveManager = main.get_node("WaveManager")
+	var bm: BuildManager = main.get_node("BuildManager")
+	var hero: Hero = main.get_node("Level/Hero")
+	check(tutorial.current_step() == Tutorial.Step.WELCOME, "starts with the welcome")
+	check(wm.time_to_next_wave() > 1000.0 and wm.current_wave == 0, "wave clock held")
+
+	tutorial.press_primary()
+	check(
+		tutorial.current_step() == Tutorial.Step.WELCOME, "an instant (accidental) tap is ignored"
+	)
+	OS.delay_msec(Tutorial.MODAL_GUARD_MS + 50)
+	tutorial.press_primary()
+	check(tutorial.current_step() == Tutorial.Step.CHOP, "welcome -> chop")
+	await _frames(120)
+	check(tutorial.current_step() == Tutorial.Step.CHOP, "no progress without an action")
+
+	hero.wood_gathered.emit(6, hero.global_position)
+	check(tutorial.current_step() == Tutorial.Step.CHOP, "not enough wood yet")
+	hero.wood_gathered.emit(6, hero.global_position)
+	check(tutorial.current_step() == Tutorial.Step.SLIMES, "wood chopped -> slimes")
+	check(wm.current_wave == 1, "the first slimes come")
+	check(wm.time_to_next_wave() > 1000.0, "next wave still held")
+
+	wm.enemy_killed.emit(15)  # the reward main adds as gold
+	check(tutorial.current_step() == Tutorial.Step.SELECT, "gold earned -> select a slot")
+	var slot: TowerSlot = null
+	for node in get_nodes_in_group(TowerSlot.GROUP):
+		if (node as TowerSlot).is_free():
+			slot = node
+			break
+	bm.select_slot(slot)
+	check(tutorial.current_step() == Tutorial.Step.BUILD, "slot selected -> build")
+	bm.clear_selection()
+	check(tutorial.current_step() == Tutorial.Step.SELECT, "deselected -> back to select")
+	bm.select_slot(slot)
+	check(bm.build_on(slot, bm.tower_types[0]), "tower built through BuildManager")
+	check(tutorial.current_step() == Tutorial.Step.MOVE, "built -> move the hero")
+
+	await _frames(5)
+	check(tutorial.current_step() == Tutorial.Step.MOVE, "standing still does not count")
+	hero.global_position += Vector3(Tutorial.MOVE_DISTANCE + 0.5, 0.0, 0.0)
+	await _frames(2)
+	check(tutorial.current_step() == Tutorial.Step.SPIN, "walked -> whirlwind")
+	check(hero.try_spin(), "whirlwind used")
+	await _frames(2)
+	check(tutorial.current_step() == Tutorial.Step.WAVE, "whirlwind -> real wave")
+	check(wm.time_to_next_wave() <= Tutorial.WAVE_DELAY + 0.1, "real wave released")
+	var waited: int = 0
+	while wm.current_wave < 2 and waited < 600:
+		await process_frame
+		waited += 1
+	check(wm.current_wave == 2, "the wave starts on its own")
+	check(
+		absf(wm.time_to_next_wave() - wm.plan.wave_duration) < 1.0,
+		"normal 30 s clock from now on (%.1f)" % wm.time_to_next_wave()
+	)
+	wm.wave_cleared.emit(2)
+	check(tutorial.current_step() == Tutorial.Step.UPGRADE, "wave cleared -> upgrade")
+	gs.add_gold(200)
+	gs.add_wood(200)
+	check(bm.upgrade(slot), "tower upgraded through BuildManager")
+	check(tutorial.current_step() == Tutorial.Step.DONE, "upgraded -> done")
+	var p: Dictionary = PlayerProfile.local()
+	check(
+		p["tutorialVersionCompleted"] == Onboarding.TUTORIAL_VERSION and p["onboardingCompleted"],
+		"completion saved"
+	)
+	check(Onboarding.route(p) == Onboarding.Route.MAP, "next launch -> map")
+
+	LevelCatalog.tutorial = false
+	paused = false
+	await _frames(90)  # let the build/upgrade effects finish before the scene goes
+	change_scene_to_file("res://scenes/main.tscn")
+	await _frames(10)
+	var normal: Node = current_scene
+	var normal_waves: WaveManager = normal.get_node("WaveManager")
+	check(normal.get_node_or_null("Tutorial") == null, "normal level 1: no tutorial")
+	check(
+		absf(normal_waves.time_to_next_wave() - normal_waves.plan.first_delay) < 1.0,
+		"normal level keeps its first delay"
+	)
+	_finish()
+
+
+func _finish() -> void:
+	LevelCatalog.erase_all()
+	print("RESULT: %s (%d failures)" % ["PASS" if fails == 0 else "FAIL", fails])
+	quit(fails)
diff --git a/tools/shot_onboarding.gd b/tools/shot_onboarding.gd
new file mode 100644
index 0000000..3d20217
--- /dev/null
+++ b/tools/shot_onboarding.gd
@@ -0,0 +1,139 @@
+extends SceneTree
+## Screenshots of the onboarding screens (nickname states, tutorial steps, the
+## account panel) for docs/screenshots. Needs a display (xvfb-run); the online
+## states use a fake HTTP layer, nothing reaches the network.
+## SHOT_DIR=/tmp/shots xvfb-run -a -s "-screen 0 1280x720x24" godot --path . \
+##   --resolution 1280x720 --rendering-driver opengl3 --script res://tools/shot_onboarding.gd
+
+const SAVE := "user://shot_progress.cfg"
+const SESSION := "user://shot_session.dat"
+
+
+## Replies like a Firebase project where "бобр" is taken, or like no network.
+class FakeTransport:
+	extends HttpTransport
+	var offline: bool = false
+
+	func send(_method: int, url: String, _headers: PackedStringArray, _body: String) -> Dictionary:
+		await get_tree().create_timer(0.2).timeout
+		if offline:
+			return {"ok": false, "code": 0, "json": null, "network": true}
+		if "signUp" in url or "securetoken" in url:
+			var auth := {
+				"idToken": "I", "refreshToken": "R", "localId": "u", "expiresIn": "3600",
+				"id_token": "I", "refresh_token": "R", "user_id": "u", "expires_in": "3600",
+			}
+			return {"ok": true, "code": 200, "json": auth, "network": false}
+		if url.ends_with("/reserveNickname"):
+			var error := {"status": "ALREADY_EXISTS", "details": {"reason": "taken"}}
+			return {"ok": false, "code": 409, "json": {"error": error}, "network": false}
+		return {"ok": false, "code": 404, "json": null, "network": false}
+
+
+var _dir: String = ""
+var _suffix: String = ""
+
+
+func _initialize() -> void:
+	LevelCatalog.save_path = SAVE
+	SessionStore.path = SESSION
+	LevelCatalog.erase_all()
+	SessionStore.clear()
+	_dir = OS.get_environment("SHOT_DIR")
+	if _dir == "":
+		_dir = ProjectSettings.globalize_path("user://")
+	_run.call_deferred()
+
+
+func _run() -> void:
+	var size: Vector2i = DisplayServer.window_get_size()
+	_suffix = "" if size.x == 1280 else "_%dx%d" % [size.x, size.y]
+	var online: Node = root.get_node("Online")
+	var fake := FakeTransport.new()
+	fake.name = "FakeTransport"
+	online.setup("fake-key", "fake-project", "europe-west1", fake)
+
+	change_scene_to_file(Onboarding.NICKNAME_SCENE)
+	await _frames(20)
+	var screen: Node = current_scene
+	screen.set_text("Сэр Ёжик")
+	await _shot("nickname_valid")
+	screen.set_text("Ёжик!!")
+	await _shot("nickname_invalid")
+	screen.set_text("Бобр")
+	screen.submit()
+	await _wait_idle(screen)
+	await _shot("nickname_taken")
+	fake.offline = true
+	screen.set_text("Сова")
+	screen.submit()
+	await _wait_idle(screen)
+	await _shot("nickname_offline")
+
+	online.setup("", "", "europe-west1", HttpTransport.new())
+	LevelCatalog.erase_all()
+	SessionStore.clear()
+	Onboarding.set_local_nickname("Сова", "сова", false)
+	Onboarding.start_tutorial(self)
+	await _frames(40)
+	await _shot("tutorial_welcome")
+	var tutorial: Tutorial = current_scene.get_node("Tutorial")
+	await create_timer(0.6).timeout
+	tutorial.press_primary()
+	await _frames(30)
+	await _shot("tutorial_chop")
+	var hero: Hero = current_scene.get_node("Level/Hero")
+	var build: BuildManager = current_scene.get_node("BuildManager")
+	hero.wood_gathered.emit(12, hero.global_position)
+	current_scene.get_node("WaveManager").enemy_killed.emit(15)
+	await _frames(20)
+	await _shot("tutorial_select")
+	for node in get_nodes_in_group(TowerSlot.GROUP):
+		if (node as TowerSlot).is_free():
+			build.select_slot(node)
+			break
+	await _frames(30)
+	await _shot("tutorial_build")
+
+	LevelCatalog.tutorial = false
+	paused = false
+	Onboarding.complete_tutorial()
+	change_scene_to_file(Onboarding.MAP_SCENE)
+	await _frames(40)
+	current_scene.get("_account").open()
+	await _frames(10)
+	await _shot("account_local")
+	# A guest account whose name and progress are waiting for the network.
+	var offline_net := FakeTransport.new()
+	offline_net.offline = true
+	online.setup("fake-key", "fake-project", "europe-west1", offline_net)
+	SessionStore.save_session({"uid": "Xk3pQ9mZ2vR7tL1wN8yA4bC6dE5f", "refresh_token": "R"})
+	change_scene_to_file(Onboarding.MAP_SCENE)
+	await create_timer(3.0).timeout
+	current_scene.get("_account").open()
+	await _frames(10)
+	await _shot("account_guest")
+	LevelCatalog.erase_all()
+	SessionStore.clear()
+	quit()
+
+
+func _frames(n: int) -> void:
+	for i in n:
+		await process_frame
+
+
+func _wait_idle(screen: Node) -> void:
+	await _frames(2)
+	for i in 300:
+		if not screen.get("_busy"):
+			break
+		await process_frame
+	await _frames(5)
+
+
+func _shot(name: String) -> void:
+	await RenderingServer.frame_post_draw
+	var path: String = _dir.path_join("onboarding_%s%s.png" % [name, _suffix])
+	root.get_texture().get_image().save_png(path)
+	print("saved ", path)
