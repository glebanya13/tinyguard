diff --git a/scripts/account_panel.gd b/scripts/account_panel.gd
new file mode 100644
index 0000000..68555d4
--- /dev/null
+++ b/scripts/account_panel.gd
@@ -0,0 +1,331 @@
+class_name AccountPanel
+extends Control
+## "Профиль" panel of the world map: nickname (rename), account type, sync
+## status, replay of the tutorial, privacy policy and account deletion.
+## Built in code like the records panel; reports navigation up by signals.
+
+signal rename_requested
+signal replay_tutorial_requested
+## The account (or the local data) was deleted: the game restarts from boot.
+signal account_deleted
+
+const GOLD := Color(0.98, 0.8, 0.4)
+const OK_COLOR := Color(0.62, 0.95, 0.42)
+const INFO_COLOR := Color(0.62, 0.86, 1.0)
+const ERROR_COLOR := Color(1.0, 0.62, 0.55)
+const SOFT_COLOR := Color(0.82, 0.86, 0.95)
+const DANGER_COLOR := Color(1.0, 0.45, 0.4)
+const VILLAGER_ICON: Texture2D = preload("res://ui/icons/villager.png")
+const PRIVACY_SUMMARY := (
+	"Мы храним только: случайный ID гостя, выбранное имя, прогресс и настройки."
+	+ " Без рекламы, аналитики, почты и геолокации. Удаление — кнопкой ниже."
+)
+
+var _name_label: Label
+var _name_badge: Label
+var _account_label: Label
+var _sync_label: Label
+var _sync_row: Control
+var _link_row: Control
+var _delete_button: Button
+var _sync_button: Button
+var _new_guest_button: Button
+var _info_label: Label
+var _id_label: Label
+var _confirm: Control
+var _confirm_title: Label
+var _confirm_body: Label
+var _confirm_status: Label
+var _confirm_yes: Button
+var _confirm_no: Button
+var _busy: bool = false
+
+
+func _ready() -> void:
+	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	_build()
+	Online.sync_state_changed.connect(_on_sync_state.unbind(1))
+	Online.account_changed.connect(refresh)
+	hide()
+
+
+func open() -> void:
+	refresh()
+	_info_label.text = ""
+	_confirm.hide()
+	show()
+
+
+## Back button: closes the confirmation first, then the panel.
+func close() -> void:
+	if _busy:
+		return
+	if _confirm.visible:
+		_confirm.hide()
+	else:
+		hide()
+
+
+func refresh() -> void:
+	var p: Dictionary = PlayerProfile.local()
+	var nick: String = str(p["nickname"])
+	_name_label.text = "Имя: " + (nick if nick != "" else "—")
+	if bool(p["nicknameConflict"]):
+		_set_label(_name_badge, "занято, выбери другое", ERROR_COLOR)
+	elif not Online.is_configured():
+		_set_label(_name_badge, "на этом устройстве", SOFT_COLOR)
+	elif bool(p["nicknameVerified"]):
+		_set_label(_name_badge, "✓ подтверждено", OK_COLOR)
+	else:
+		_set_label(_name_badge, "ждёт проверки", INFO_COLOR)
+	match Online.account_type():
+		"local":
+			_account_label.text = "Онлайн выключен: всё хранится только на этом устройстве"
+		"guest":
+			_account_label.text = "Гостевой аккаунт: прогресс в облаке, вход с этого устройства"
+		"email":
+			_account_label.text = "Аккаунт с почтой: можно войти на другом устройстве"
+		_:
+			_account_label.text = "Гостевой аккаунт создастся, когда появится связь"
+	_on_sync_state()
+	var configured: bool = Online.is_configured()
+	_sync_row.visible = configured
+	_link_row.visible = configured
+	_delete_button.text = "Удалить аккаунт" if configured else "Удалить данные"
+	var uid: String = Online.auth.uid if configured else ""
+	_id_label.text = "ID игрока (для поддержки): " + uid if uid != "" else ""
+
+
+func _on_sync_state() -> void:
+	if _sync_label == null:
+		return
+	var state: String = Online.sync_state()
+	var color: Color = OK_COLOR if state in ["synced", "off"] else INFO_COLOR
+	if state in ["offline", "pending", "session_lost", "newer", "disabled"]:
+		color = ERROR_COLOR if state != "pending" else INFO_COLOR
+	_set_label(_sync_label, Online.state_text(state), color)
+	_sync_button.visible = Online.is_configured()
+	_sync_button.disabled = state == "syncing"
+	_new_guest_button.visible = state == "session_lost"
+
+
+func _build() -> void:
+	var dim := ColorRect.new()
+	dim.color = Color(0.04, 0.06, 0.14, 0.6)
+	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(dim)
+	var center := CenterContainer.new()
+	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(center)
+	var panel := PanelContainer.new()
+	panel.custom_minimum_size = Vector2(800, 0)
+	center.add_child(panel)
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 10)
+	panel.add_child(box)
+
+	var header := HBoxContainer.new()
+	header.add_theme_constant_override("separation", 12)
+	box.add_child(header)
+	var icon := TextureRect.new()
+	icon.texture = VILLAGER_ICON
+	icon.custom_minimum_size = Vector2(56, 56)
+	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
+	header.add_child(icon)
+	var title := _label("Профиль", 36, GOLD)
+	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	header.add_child(title)
+	header.add_child(_button("Готово", close, false, 180))
+
+	var name_row := HBoxContainer.new()
+	name_row.add_theme_constant_override("separation", 12)
+	box.add_child(name_row)
+	_name_label = _label("", 28)
+	name_row.add_child(_name_label)
+	_name_badge = _label("", 18)
+	_name_badge.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	name_row.add_child(_name_badge)
+	name_row.add_child(_button("Сменить имя", rename_requested.emit, true, 220))
+
+	_account_label = _label("", 20, SOFT_COLOR)
+	_account_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	box.add_child(_account_label)
+
+	var sync_row := HBoxContainer.new()
+	_sync_row = sync_row
+	sync_row.add_theme_constant_override("separation", 12)
+	box.add_child(sync_row)
+	_sync_label = _label("", 20)
+	_sync_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	sync_row.add_child(_sync_label)
+	_new_guest_button = _button("Новый гость", _on_new_guest, true, 200)
+	sync_row.add_child(_new_guest_button)
+	_sync_button = _button("Синхронизировать", _on_sync_pressed, true, 260)
+	sync_row.add_child(_sync_button)
+
+	var link_row := HBoxContainer.new()
+	_link_row = link_row
+	link_row.add_theme_constant_override("separation", 12)
+	box.add_child(link_row)
+	var link := _button("Привязать аккаунт", Callable(), true, 260)
+	link.disabled = true
+	link_row.add_child(link)
+	var link_note := _label(
+		"Скоро: вход на другом устройстве. Пока гость живёт на этом телефоне.", 17, SOFT_COLOR
+	)
+	link_note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	link_note.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	link_row.add_child(link_note)
+
+	var actions := HBoxContainer.new()
+	actions.add_theme_constant_override("separation", 12)
+	actions.alignment = BoxContainer.ALIGNMENT_CENTER
+	box.add_child(actions)
+	actions.add_child(_button("Пройти обучение заново", replay_tutorial_requested.emit, true, 300))
+	actions.add_child(_button("Конфиденциальность", _on_privacy_pressed, true, 260))
+	var delete := _button("Удалить аккаунт", _ask_delete, true, 200)
+	_delete_button = delete
+	delete.add_theme_color_override("font_color", DANGER_COLOR)
+	delete.add_theme_color_override("font_hover_color", DANGER_COLOR)
+	actions.add_child(delete)
+
+	_info_label = _label("", 18, SOFT_COLOR)
+	_info_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	_info_label.custom_minimum_size = Vector2(740, 0)
+	box.add_child(_info_label)
+	_id_label = _label("", 15, Color(SOFT_COLOR, 0.75))
+	box.add_child(_id_label)
+
+	_build_confirm()
+
+
+func _build_confirm() -> void:
+	_confirm = Control.new()
+	_confirm.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(_confirm)
+	var dim := ColorRect.new()
+	dim.color = Color(0.04, 0.06, 0.14, 0.7)
+	dim.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	_confirm.add_child(dim)
+	var center := CenterContainer.new()
+	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	_confirm.add_child(center)
+	var panel := PanelContainer.new()
+	panel.custom_minimum_size = Vector2(680, 0)
+	center.add_child(panel)
+	var box := VBoxContainer.new()
+	box.add_theme_constant_override("separation", 14)
+	panel.add_child(box)
+	_confirm_title = _label("Удалить аккаунт?", 34, DANGER_COLOR)
+	box.add_child(_confirm_title)
+	_confirm_body = _label("", 20)
+	_confirm_body.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	_confirm_body.custom_minimum_size = Vector2(620, 0)
+	box.add_child(_confirm_body)
+	_confirm_status = _label("", 19, INFO_COLOR)
+	_confirm_status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	_confirm_status.custom_minimum_size = Vector2(620, 0)
+	box.add_child(_confirm_status)
+	var buttons := HBoxContainer.new()
+	buttons.alignment = BoxContainer.ALIGNMENT_CENTER
+	buttons.add_theme_constant_override("separation", 16)
+	box.add_child(buttons)
+	_confirm_no = _button("Отмена", close, false, 220)
+	buttons.add_child(_confirm_no)
+	_confirm_yes = _button("Удалить навсегда", _on_delete_confirmed, true, 280)
+	_confirm_yes.add_theme_color_override("font_color", DANGER_COLOR)
+	_confirm_yes.add_theme_color_override("font_hover_color", DANGER_COLOR)
+	buttons.add_child(_confirm_yes)
+	_confirm.hide()
+
+
+func _ask_delete() -> void:
+	var online: bool = Online.is_configured() and Online.auth.uid != ""
+	_confirm_title.text = "Удалить аккаунт?" if online else "Удалить данные?"
+	_confirm_body.text = (
+		(
+			"Удалим имя, прогресс, настройки и рекорды — на сервере и на этом устройстве."
+			+ " Вернуть их будет нельзя."
+		)
+		if online
+		else "Удалим имя, прогресс и настройки с этого устройства. Вернуть их будет нельзя."
+	)
+	_confirm_status.text = ""
+	_confirm_yes.disabled = false
+	_confirm_no.disabled = false
+	_confirm.show()
+
+
+func _on_delete_confirmed() -> void:
+	if _busy:
+		return
+	_busy = true
+	_confirm_yes.disabled = true
+	_confirm_no.disabled = true
+	_set_label(_confirm_status, "Удаляем…", INFO_COLOR)
+	var result: Dictionary = await Online.delete_account()
+	_busy = false
+	if result["ok"]:
+		account_deleted.emit()
+		return
+	_confirm_no.disabled = false
+	_confirm_yes.disabled = false
+	var text := "Не получилось удалить аккаунт. Попробуйте позже."
+	match str(result["reason"]):
+		"offline", "unavailable":
+			text = "Нужен интернет: данные на сервере можно удалить только онлайн. Попробуйте позже."
+		"session_lost", "no_session":
+			text = (
+				"Вход на этом устройстве потерян, поэтому удалить данные на сервере отсюда нельзя."
+				+ " Напишите в поддержку и укажите ID игрока из Профиля."
+			)
+	_set_label(_confirm_status, text, ERROR_COLOR)
+
+
+func _on_sync_pressed() -> void:
+	_info_label.text = ""
+	var result: Dictionary = await Online.sync_now()
+	refresh()
+	if not result["ok"] and str(result["error"]) == "offline":
+		_set_label(_info_label, "Нет связи — синхронизируем, когда появится интернет", INFO_COLOR)
+
+
+func _on_new_guest() -> void:
+	var result: Dictionary = await Online.start_new_guest()
+	refresh()
+	if not result["ok"]:
+		_set_label(_info_label, "Нет связи с сервером — попробуйте позже", ERROR_COLOR)
+
+
+func _on_privacy_pressed() -> void:
+	if GameInfo.PRIVACY_URL != "":
+		OS.shell_open(GameInfo.PRIVACY_URL)
+	else:
+		_set_label(_info_label, PRIVACY_SUMMARY, SOFT_COLOR)
+
+
+func _label(text: String, size: int, color: Color = Color(1, 0.96, 0.87)) -> Label:
+	var label := Label.new()
+	label.text = text
+	label.add_theme_font_size_override("font_size", size)
+	label.add_theme_color_override("font_color", color)
+	return label
+
+
+func _button(text: String, action: Callable, secondary: bool, width: float) -> Button:
+	var button := Button.new()
+	button.text = text
+	button.focus_mode = Control.FOCUS_NONE
+	button.custom_minimum_size = Vector2(width, 58)
+	button.add_theme_font_size_override("font_size", 21)
+	if secondary:
+		button.theme_type_variation = &"SecondaryButton"
+	if action.is_valid():
+		button.pressed.connect(action)
+	return button
+
+
+func _set_label(label: Label, text: String, color: Color) -> void:
+	label.text = text
+	label.add_theme_color_override("font_color", color)
diff --git a/scripts/auth_service.gd b/scripts/auth_service.gd
new file mode 100644
index 0000000..17b8adb
--- /dev/null
+++ b/scripts/auth_service.gd
@@ -0,0 +1,315 @@
+class_name AuthService
+extends RefCounted
+## Firebase Authentication over its REST APIs (Identity Toolkit + Secure Token),
+## no SDK and no native plugin. Providers:
+## - anonymous (guest): accounts:signUp, the default on first launch;
+## - email/password linking of a guest: accounts:update with the guest idToken
+##   (keeps the uid, so the profile and progress stay). Service level only, the
+##   UI does not offer it yet;
+## - IdP linking (Google, Play Games...): accounts:signInWithIdp needs an id
+##   token from a native sign-in, which CLAUDE.md forbids, so link_with_idp()
+##   answers "not_available". Design in docs/ACCOUNTS.md.
+##
+## Rules this class keeps:
+## - one token refresh / sign-up in flight; concurrent callers share its result;
+## - transient failures (no reply, 429, 5xx) are retried a few times with
+##   backoff, except sign-up (not idempotent: a retry could make two accounts);
+## - a known uid whose refresh token is merely unreachable (offline, server
+##   error, unreadable session file) is never replaced by a new guest account;
+##   only a refresh token the server rejects for good on a guest account leads
+##   to a new guest (and only when the caller allows creating one);
+## - tokens, emails and raw replies are never printed.
+
+## Emitted when the uid or the account type changes.
+signal changed
+## A token request finished (concurrent ensure_token() callers wait for this).
+signal token_request_finished(result: Dictionary)
+
+const SIGN_UP_URL := "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=%s"
+const UPDATE_URL := "https://identitytoolkit.googleapis.com/v1/accounts:update?key=%s"
+const REFRESH_URL := "https://securetoken.googleapis.com/v1/token?key=%s"
+const TYPE_GUEST := "guest"
+const TYPE_EMAIL := "email"
+## Refresh this long before the id token expires (seconds).
+const EXPIRY_MARGIN := 60.0
+const MAX_ATTEMPTS := 3
+const BACKOFF_SECONDS := 0.8
+## Secure Token errors that mean the refresh token will never work again.
+const DEAD_SESSION_ERRORS: Array[String] = [
+	"TOKEN_EXPIRED",
+	"INVALID_REFRESH_TOKEN",
+	"USER_NOT_FOUND",
+	"INVALID_GRANT_TYPE",
+	"MISSING_REFRESH_TOKEN",
+]
+const LINK_ERRORS := {
+	"EMAIL_EXISTS": "credential_in_use",
+	"CREDENTIAL_ALREADY_IN_USE": "credential_in_use",
+	"FEDERATED_USER_ID_ALREADY_LINKED": "credential_in_use",
+	"INVALID_EMAIL": "invalid_email",
+	"WEAK_PASSWORD": "weak_password",
+	"CREDENTIAL_TOO_OLD_LOGIN_AGAIN": "reauth_required",
+	"OPERATION_NOT_ALLOWED": "not_available",
+}
+
+var api_key: String = ""
+var transport: HttpTransport = null
+## Unix time source; tests replace it.
+var clock: Callable = Time.get_unix_time_from_system
+## 0 makes retries immediate (tests).
+var backoff_scale: float = 1.0
+var uid: String = ""
+## TYPE_GUEST, TYPE_EMAIL or "" (no account yet).
+var account_type: String = ""
+## uid of a guest account that had to be replaced (its refresh token was dead).
+var previous_uid: String = ""
+
+var _id_token: String = ""
+var _refresh_token: String = ""
+var _expires_at: float = 0.0
+var _in_flight: bool = false
+
+
+## Loads the stored session. `known_uid` is the uid the progress file remembers:
+## if the session file is gone or unreadable, that identity is "lost" and is
+## not silently replaced (see ensure_token).
+func restore(known_uid: String = "") -> void:
+	var session: Dictionary = SessionStore.load_session()
+	uid = str(session.get("uid", known_uid))
+	_refresh_token = str(session.get("refresh_token", ""))
+	account_type = str(session.get("account_type", TYPE_GUEST if uid != "" else ""))
+	previous_uid = str(session.get("previous_uid", ""))
+	_id_token = ""
+	_expires_at = 0.0
+
+
+## Moves a session saved by older versions (plain text in progress.cfg) into
+## the encrypted store.
+func adopt_legacy(legacy_uid: String, refresh_token: String) -> void:
+	if legacy_uid == "" or refresh_token == "" or _refresh_token != "":
+		return
+	uid = legacy_uid
+	_refresh_token = refresh_token
+	account_type = TYPE_GUEST
+	_persist()
+
+
+func is_configured() -> bool:
+	return api_key != "" and transport != null
+
+
+func has_session() -> bool:
+	return uid != "" and _refresh_token != ""
+
+
+## A uid is known but its refresh token is not (session file lost/unreadable).
+func is_session_lost() -> bool:
+	return uid != "" and _refresh_token == ""
+
+
+func id_token() -> String:
+	return _id_token
+
+
+func is_token_fresh() -> bool:
+	return _id_token != "" and clock.call() < _expires_at - EXPIRY_MARGIN
+
+
+## Forces a refresh on the next ensure_token (e.g. after a 401).
+func invalidate_token() -> void:
+	_id_token = ""
+	_expires_at = 0.0
+
+
+## Makes sure a fresh id token is available. {"ok", "error", "created"}.
+## Errors: not_configured, offline, server, session_lost, disabled, no_session.
+func ensure_token(allow_create: bool = true) -> Dictionary:
+	if is_token_fresh():
+		return {"ok": true, "error": "", "created": false}
+	if _in_flight:
+		return await token_request_finished
+	_in_flight = true
+	var result: Dictionary = await _acquire(allow_create)
+	_in_flight = false
+	token_request_finished.emit(result)
+	return result
+
+
+## Explicit user choice (account panel): drop a lost identity, start a new guest.
+func start_new_guest() -> Dictionary:
+	if _in_flight:
+		return {"ok": false, "error": "busy", "created": false}
+	forget()
+	return await ensure_token(true)
+
+
+## Forgets the session on this device (after account deletion).
+func forget() -> void:
+	uid = ""
+	account_type = ""
+	previous_uid = ""
+	_refresh_token = ""
+	invalidate_token()
+	SessionStore.clear()
+	changed.emit()
+
+
+## Links an email/password credential to the current (guest) account; the uid
+## and everything stored under it stay. {"ok", "error"}: credential_in_use
+## (the email belongs to another account: sign in there instead, nothing is
+## merged automatically), invalid_email, weak_password, reauth_required,
+## not_available (provider disabled in the console), offline, server.
+func link_email(email: String, password: String) -> Dictionary:
+	var auth: Dictionary = await ensure_token(false)
+	if not auth["ok"]:
+		return {"ok": false, "error": auth["error"]}
+	var body := {
+		"idToken": _id_token, "email": email, "password": password, "returnSecureToken": true
+	}
+	var reply: Dictionary = await _post_json(UPDATE_URL % api_key, body, false)
+	if not reply["ok"]:
+		return {"ok": false, "error": _link_error(reply)}
+	_take_tokens(reply["json"], "idToken", "refreshToken", "localId", "expiresIn")
+	account_type = TYPE_EMAIL
+	_persist()
+	changed.emit()
+	return {"ok": true, "error": ""}
+
+
+## Linking through an identity provider (accounts:signInWithIdp with the guest
+## idToken) needs a provider id token from a native SDK; not available without
+## native plugins. Never pretends to succeed.
+func link_with_idp(_provider_id: String, _provider_token: String) -> Dictionary:
+	return {"ok": false, "error": "not_available"}
+
+
+## First word of a Firebase REST error message ("WEAK_PASSWORD : ..." -> WEAK_PASSWORD).
+static func error_message(json: Variant) -> String:
+	if not json is Dictionary:
+		return ""
+	var error: Variant = (json as Dictionary).get("error", {})
+	if error is Dictionary:
+		return str((error as Dictionary).get("message", "")).get_slice(" ", 0)
+	return str(error).get_slice(" ", 0)  # Secure Token may answer {"error": "invalid_grant"}
+
+
+func _acquire(allow_create: bool) -> Dictionary:
+	if not is_configured():
+		return {"ok": false, "error": "not_configured", "created": false}
+	if _refresh_token != "":
+		var refreshed: Dictionary = await _refresh()
+		if refreshed["ok"] or refreshed["error"] != "dead":
+			return refreshed
+		# The server rejected the refresh token for good.
+		if account_type != TYPE_GUEST or not allow_create:
+			_refresh_token = ""
+			_persist()
+			return {"ok": false, "error": "session_lost", "created": false}
+		previous_uid = uid
+		uid = ""
+		_refresh_token = ""
+	elif uid != "":
+		return {"ok": false, "error": "session_lost", "created": false}
+	if not allow_create:
+		return {"ok": false, "error": "no_session", "created": false}
+	return await _sign_up()
+
+
+func _refresh() -> Dictionary:
+	var form := "grant_type=refresh_token&refresh_token=" + _refresh_token.uri_encode()
+	var reply: Dictionary = await _send_with_retry(
+		HTTPClient.METHOD_POST,
+		REFRESH_URL % api_key,
+		PackedStringArray(["Content-Type: application/x-www-form-urlencoded"]),
+		form,
+		true
+	)
+	if reply["ok"]:
+		var before: String = uid
+		_take_tokens(reply["json"], "id_token", "refresh_token", "user_id", "expires_in")
+		_persist()
+		if uid != before:
+			changed.emit()
+		return {
+			"ok": _id_token != "", "error": "" if _id_token != "" else "server", "created": false
+		}
+	if HttpTransport.is_transient(reply):
+		return {"ok": false, "error": "offline" if reply["network"] else "server", "created": false}
+	var message: String = error_message(reply["json"])
+	if message == "USER_DISABLED":
+		return {"ok": false, "error": "disabled", "created": false}
+	if DEAD_SESSION_ERRORS.has(message) or message == "invalid_grant":
+		return {"ok": false, "error": "dead", "created": false}
+	return {"ok": false, "error": "server", "created": false}
+
+
+func _sign_up() -> Dictionary:
+	var reply: Dictionary = await _post_json(
+		SIGN_UP_URL % api_key, {"returnSecureToken": true}, false
+	)
+	if not reply["ok"]:
+		var network: bool = reply["network"]
+		return {"ok": false, "error": "offline" if network else "server", "created": false}
+	_take_tokens(reply["json"], "idToken", "refreshToken", "localId", "expiresIn")
+	account_type = TYPE_GUEST
+	_persist()
+	changed.emit()
+	return {"ok": uid != "", "error": "" if uid != "" else "server", "created": true}
+
+
+func _take_tokens(
+	json: Variant, id_key: String, refresh_key: String, uid_key: String, ttl_key: String
+) -> void:
+	var data: Dictionary = json if json is Dictionary else {}
+	_id_token = str(data.get(id_key, ""))
+	_refresh_token = str(data.get(refresh_key, _refresh_token))
+	uid = str(data.get(uid_key, uid))
+	_expires_at = float(clock.call()) + float(str(data.get(ttl_key, "3600")))
+
+
+func _persist() -> void:
+	if uid == "" and _refresh_token == "":
+		SessionStore.clear()
+		return
+	(
+		SessionStore
+		. save_session(
+			{
+				"uid": uid,
+				"refresh_token": _refresh_token,
+				"account_type": account_type,
+				"previous_uid": previous_uid,
+			}
+		)
+	)
+
+
+func _link_error(reply: Dictionary) -> String:
+	if HttpTransport.is_transient(reply):
+		return "offline" if reply["network"] else "server"
+	return str(LINK_ERRORS.get(error_message(reply["json"]), "server"))
+
+
+func _post_json(url: String, body: Dictionary, retry: bool) -> Dictionary:
+	return await _send_with_retry(
+		HTTPClient.METHOD_POST,
+		url,
+		PackedStringArray(["Content-Type: application/json"]),
+		JSON.stringify(body),
+		retry
+	)
+
+
+func _send_with_retry(
+	method: int, url: String, headers: PackedStringArray, body: String, retry: bool
+) -> Dictionary:
+	var reply: Dictionary = {}
+	var attempts: int = MAX_ATTEMPTS if retry else 1
+	for attempt in attempts:
+		if attempt > 0 and backoff_scale > 0.0:
+			var delay: float = BACKOFF_SECONDS * pow(2.0, attempt - 1) * randf_range(0.8, 1.2)
+			await transport.get_tree().create_timer(delay * backoff_scale).timeout
+		reply = await transport.send(method, url, headers, body)
+		if not HttpTransport.is_transient(reply):
+			break
+	return reply
diff --git a/scripts/boot.gd b/scripts/boot.gd
new file mode 100644
index 0000000..ae5757f
--- /dev/null
+++ b/scripts/boot.gd
@@ -0,0 +1,35 @@
+extends Control
+## Entry scene: starts the online services in the background (guest sign-in,
+## profile sync — offline is fine), then routes by the local profile:
+## nickname screen, the tutorial, or straight to the world map.
+
+## A new player waits at most this long for the guest sign-in (seconds);
+## returning players never wait.
+const AUTH_WAIT := 3.0
+
+var _routed: bool = false
+
+
+func _ready() -> void:
+	$Center/Box/Title.text = GameInfo.TITLE
+	LevelCatalog.apply_sound()
+	LevelCatalog.tutorial = false
+	Onboarding.rename_mode = false
+	_run.call_deferred()
+
+
+func _notification(what: int) -> void:
+	if what == NOTIFICATION_WM_GO_BACK_REQUEST:
+		get_tree().quit()
+
+
+func _run() -> void:
+	Online.start()  # not awaited: it may take long or never answer offline
+	if Onboarding.route(PlayerProfile.local()) != Onboarding.Route.MAP:
+		var deadline: int = Time.get_ticks_msec() + int(AUTH_WAIT * 1000.0)
+		while not Online.startup_done and Time.get_ticks_msec() < deadline:
+			await get_tree().process_frame
+	if _routed:
+		return
+	_routed = true
+	Onboarding.go(get_tree(), Onboarding.route(PlayerProfile.local()))
diff --git a/scripts/firestore_client.gd b/scripts/firestore_client.gd
new file mode 100644
index 0000000..c3e801d
--- /dev/null
+++ b/scripts/firestore_client.gd
@@ -0,0 +1,188 @@
+class_name FirestoreClient
+extends RefCounted
+## Cloud Firestore REST v1 (documents.get / commit / delete / runQuery) and
+## callable Cloud Functions over HTTPS, signed with AuthService's id token.
+## Values are converted between Godot types and Firestore's typed JSON here.
+## Transient failures are retried with backoff; a 401 refreshes the token once.
+
+const HOST := "https://firestore.googleapis.com/v1"
+const ROOT := "projects/%s/databases/(default)/documents"
+const FUNCTIONS_URL := "https://%s-%s.cloudfunctions.net/%s"
+const MAX_ATTEMPTS := 3
+const BACKOFF_SECONDS := 0.8
+
+var project_id: String = ""
+var functions_region: String = "europe-west1"
+var transport: HttpTransport = null
+var auth: AuthService = null
+## 0 makes retries immediate (tests).
+var backoff_scale: float = 1.0
+
+
+## Full resource name of a document ("users/abc" -> "projects/p/.../users/abc").
+func doc_name(path: String) -> String:
+	return (ROOT % project_id) + "/" + path
+
+
+func doc_url(path: String) -> String:
+	return HOST + "/" + doc_name(path)
+
+
+## {"ok", "code", "missing" (404), "fields" (decoded Dictionary), "update_time", "network"}.
+func get_doc(path: String) -> Dictionary:
+	var reply: Dictionary = await request(HTTPClient.METHOD_GET, doc_url(path), null, true)
+	var json: Dictionary = reply["json"] if reply["json"] is Dictionary else {}
+	reply["missing"] = int(reply["code"]) == 404
+	reply["fields"] = decode_fields(json.get("fields", {})) if reply["ok"] else {}
+	reply["update_time"] = str(json.get("updateTime", ""))
+	return reply
+
+
+func delete_doc(path: String) -> Dictionary:
+	return await request(HTTPClient.METHOD_DELETE, doc_url(path), null, true)
+
+
+## documents:commit with the given writes (atomic).
+func commit(writes: Array) -> Dictionary:
+	var url: String = HOST + "/" + (ROOT % project_id) + ":commit"
+	return await request(HTTPClient.METHOD_POST, url, {"writes": writes}, true)
+
+
+## Structured query under `parent` ("" = root, else e.g. "leaderboards/level_1").
+func run_query(parent: String, query: Dictionary, signed: bool) -> Dictionary:
+	var base: String = HOST + "/" + (ROOT % project_id)
+	var url: String = (base + "/" + parent if parent != "" else base) + ":runQuery"
+	return await request(HTTPClient.METHOD_POST, url, {"structuredQuery": query}, signed)
+
+
+## Calls an HTTPS callable function. {"ok", "result", "reason", "status", "network"}.
+func call_function(name: String, data: Dictionary) -> Dictionary:
+	var url: String = FUNCTIONS_URL % [functions_region, project_id, name]
+	var reply: Dictionary = await request(HTTPClient.METHOD_POST, url, {"data": data}, true)
+	var parsed: Dictionary = parse_callable_reply(reply)
+	parsed["network"] = reply.get("network", false)
+	return parsed
+
+
+## One request with retries. `body` is null or a Dictionary (sent as JSON).
+func request(method: int, url: String, body: Variant, signed: bool) -> Dictionary:
+	var reply: Dictionary = {}
+	var refreshed := false
+	var attempt: int = 0
+	while attempt < MAX_ATTEMPTS:
+		if attempt > 0 and backoff_scale > 0.0:
+			var delay: float = BACKOFF_SECONDS * pow(2.0, attempt - 1) * randf_range(0.8, 1.2)
+			await transport.get_tree().create_timer(delay * backoff_scale).timeout
+		var headers := PackedStringArray()
+		if body != null:
+			headers.append("Content-Type: application/json")
+		if signed:
+			headers.append("Authorization: Bearer " + auth.id_token())
+		var payload: String = JSON.stringify(body) if body != null else ""
+		reply = await transport.send(method, url, headers, payload)
+		if int(reply["code"]) == 401 and signed and not refreshed:
+			refreshed = true
+			auth.invalidate_token()
+			var again: Dictionary = await auth.ensure_token(false)
+			if not again["ok"]:
+				break
+			continue  # the retry with a new token does not count as an attempt
+		if not HttpTransport.is_transient(reply) or _is_app_error(reply):
+			break
+		attempt += 1
+	return reply
+
+
+## A deliberate answer of our functions (e.g. 429 rate_limited): do not retry.
+static func _is_app_error(reply: Dictionary) -> bool:
+	var json: Variant = reply.get("json")
+	if not json is Dictionary or not (json as Dictionary).get("error") is Dictionary:
+		return false
+	var details: Variant = (json["error"] as Dictionary).get("details")
+	return details is Dictionary and (details as Dictionary).has("reason")
+
+
+## Callable protocol reply -> {"ok", "result", "reason", "status"}. Errors come
+## as {"error": {"status": "ALREADY_EXISTS", "message", "details": {"reason"}}}.
+static func parse_callable_reply(reply: Dictionary) -> Dictionary:
+	var json: Dictionary = reply.get("json") if reply.get("json") is Dictionary else {}
+	if reply.get("ok", false) and json.has("result"):
+		return {"ok": true, "result": json["result"], "reason": "", "status": "OK"}
+	var error: Dictionary = json.get("error") if json.get("error") is Dictionary else {}
+	var details: Dictionary = error.get("details") if error.get("details") is Dictionary else {}
+	var status: String = str(error.get("status", ""))
+	var reason: String = str(details.get("reason", ""))
+	if reason == "":
+		if HttpTransport.is_transient(reply):
+			reason = "offline" if reply.get("network", false) else "unavailable"
+		elif int(reply.get("code", 0)) == 404:
+			reason = "unavailable"  # function not deployed
+		else:
+			reason = "server"
+	return {"ok": false, "result": null, "reason": reason, "status": status}
+
+
+static func encode_value(value: Variant) -> Dictionary:
+	match typeof(value):
+		TYPE_BOOL:
+			return {"booleanValue": value}
+		TYPE_INT:
+			return {"integerValue": str(value)}
+		TYPE_FLOAT:
+			return {"doubleValue": value}
+		TYPE_STRING, TYPE_STRING_NAME:
+			return {"stringValue": str(value)}
+		TYPE_DICTIONARY:
+			return {"mapValue": {"fields": encode_fields(value)}}
+		TYPE_ARRAY:
+			var values: Array = []
+			for item: Variant in value:
+				values.append(encode_value(item))
+			return {"arrayValue": {"values": values}}
+	return {"nullValue": null}
+
+
+static func encode_fields(data: Dictionary) -> Dictionary:
+	var out := {}
+	for key: Variant in data:
+		out[str(key)] = encode_value(data[key])
+	return out
+
+
+## Typed Firestore value -> Godot value. Timestamps become unix seconds (int).
+static func decode_value(value: Variant) -> Variant:
+	if not value is Dictionary:
+		return null
+	var v: Dictionary = value
+	if v.has("booleanValue"):
+		return bool(v["booleanValue"])
+	if v.has("integerValue"):
+		return int(str(v["integerValue"]))
+	if v.has("doubleValue"):
+		return float(v["doubleValue"])
+	if v.has("stringValue"):
+		return str(v["stringValue"])
+	if v.has("timestampValue"):
+		return parse_timestamp(str(v["timestampValue"]))
+	if v.has("mapValue"):
+		return decode_fields((v["mapValue"] as Dictionary).get("fields", {}))
+	if v.has("arrayValue"):
+		var out: Array = []
+		for item: Variant in (v["arrayValue"] as Dictionary).get("values", []):
+			out.append(decode_value(item))
+		return out
+	return null
+
+
+static func decode_fields(fields: Variant) -> Dictionary:
+	var out := {}
+	if fields is Dictionary:
+		for key: Variant in fields:
+			out[str(key)] = decode_value(fields[key])
+	return out
+
+
+## "2026-10-14T12:30:00.123456Z" -> unix seconds.
+static func parse_timestamp(text: String) -> int:
+	var plain: String = text.get_slice(".", 0).trim_suffix("Z")
+	return Time.get_unix_time_from_datetime_string(plain)
