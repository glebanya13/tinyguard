diff --git a/scripts/nickname_rules.gd b/scripts/nickname_rules.gd
new file mode 100644
index 0000000..be57619
--- /dev/null
+++ b/scripts/nickname_rules.gd
@@ -0,0 +1,115 @@
+class_name NicknameRules
+extends RefCounted
+## Nickname policy. The server applies the same rules in
+## firebase/functions/src/nickname.ts (both are checked against
+## tests/nickname_cases.json); change them together.
+##
+## - Spaces at the ends are dropped and runs of whitespace become one space.
+## - 3..16 characters after that.
+## - Letters of the Latin alphabet (with accents: U+00C0..U+017F) and of the
+##   Cyrillic one (U+0401..U+045F without U+040D), digits 0-9; a single space or
+##   underscore only between two letters/digits. Nothing else: no control or
+##   invisible characters, emoji, symbols or combining marks.
+## - Key for uniqueness (normalize): lower case, "ё" -> "е", space -> "_".
+##   "Сэр Ёжик" and "сэр_ежик" are the same name.
+## - A few reserved names (RESERVED, compared normalized).
+
+const MIN_LENGTH := 3
+const MAX_LENGTH := 16
+## Normalized names nobody may take ("рыцарь" is the anonymous leaderboard name).
+const RESERVED: Array[String] = [
+	"admin",
+	"administrator",
+	"moderator",
+	"support",
+	"system",
+	"tinyguard",
+	"bimbleguard",
+	"рыцарь",
+	"админ",
+	"администратор",
+	"модератор",
+	"поддержка",
+]
+const MESSAGES := {
+	"too_short": "Минимум %d символа" % MIN_LENGTH,
+	"too_long": "Не больше %d символов" % MAX_LENGTH,
+	"bad_char": "Только буквы, цифры, пробел и _",
+	"bad_separator": "Пробел и _ — только между буквами",
+	"reserved": "Это имя занято королевством",
+	"taken": "Это имя уже занято — попробуй другое",
+	"rate_limited": "Имя можно менять не чаще раза в сутки",
+}
+
+
+## Trimmed, with every run of whitespace replaced by a single space.
+static func clean(raw: String) -> String:
+	var out := ""
+	var gap := false
+	for ch in raw.strip_edges():
+		var code: int = ch.unicode_at(0)
+		if code == 32 or code == 9 or code == 10 or code == 13 or code == 0xA0:
+			gap = true
+			continue
+		if gap and out != "":
+			out += " "
+		gap = false
+		out += ch
+	return out
+
+
+## {"ok", "nickname" (cleaned), "normalized", "error" (code or ""), "message"}.
+static func validate(raw: String) -> Dictionary:
+	var name: String = clean(raw)
+	var error: String = _error_code(name)
+	var normalized: String = normalize(name) if error == "" else ""
+	if error == "" and RESERVED.has(normalized):
+		error = "reserved"
+	return {
+		"ok": error == "",
+		"nickname": name,
+		"normalized": normalized if error == "" else "",
+		"error": error,
+		"message": message(error),
+	}
+
+
+static func message(error: String) -> String:
+	return str(MESSAGES.get(error, ""))
+
+
+## Uniqueness key of a valid (cleaned) nickname.
+static func normalize(name: String) -> String:
+	return name.to_lower().replace("ё", "е").replace(" ", "_")
+
+
+## Only ranges where Godot's String.to_lower() and JavaScript's toLowerCase()
+## agree (checked code point by code point); wider ranges differ in Godot 4.3.
+static func is_letter_or_digit(code: int) -> bool:
+	return (
+		(code >= 0x30 and code <= 0x39)
+		or (code >= 0x41 and code <= 0x5A)
+		or (code >= 0x61 and code <= 0x7A)
+		or (code >= 0xC0 and code <= 0x17F and code != 0xD7 and code != 0xF7 and code != 0x130)
+		or (code >= 0x401 and code <= 0x45F and code != 0x40D)
+	)
+
+
+static func _error_code(name: String) -> String:
+	if name.length() < MIN_LENGTH:
+		return "too_short"
+	if name.length() > MAX_LENGTH:
+		return "too_long"
+	var bad_separator := false
+	var previous_separator := true  # nothing before the first character
+	for ch in name:
+		var code: int = ch.unicode_at(0)
+		var separator: bool = code == 32 or code == 0x5F
+		if not separator and not is_letter_or_digit(code):
+			return "bad_char"
+		if separator and previous_separator:
+			bad_separator = true
+		previous_separator = separator
+	if bad_separator or previous_separator:
+		return "bad_separator"
+	return ""
diff --git a/scripts/nickname_screen.gd b/scripts/nickname_screen.gd
new file mode 100644
index 0000000..f2fbb91
--- /dev/null
+++ b/scripts/nickname_screen.gd
@@ -0,0 +1,182 @@
+extends Control
+## Nickname screen (first launch, a taken name, or "Сменить имя" on the map).
+## Live validation with NicknameRules, then Online.reserve_nickname(): the
+## server reserves the name (unique, case-insensitive); offline or without
+## Firebase the name is kept on the device and reserved later. A taken name is
+## never replaced silently: the player picks another one.
+
+const OK_COLOR := Color(0.62, 0.95, 0.42)
+const ERROR_COLOR := Color(1.0, 0.62, 0.55)
+const INFO_COLOR := Color(0.62, 0.86, 1.0)
+const NEUTRAL_COLOR := Color(0.82, 0.86, 0.95)
+const DEFAULT_HINT := "3–16 букв или цифр, можно пробел и _"
+## Pause on the "nice to meet you" message before moving on (seconds).
+const SUCCESS_PAUSE := 0.9
+
+var _busy: bool = false
+## After an offline save the button only continues.
+var _saved_offline: bool = false
+var _tried: bool = false
+
+@onready var _safe: MarginContainer = $Safe
+@onready var _art: Control = $Safe/Center/Row/Art
+@onready var _subtitle: Label = $Safe/Center/Row/Panel/Content/Subtitle
+@onready var _edit: LineEdit = $Safe/Center/Row/Panel/Content/NameEdit
+@onready var _message: Label = $Safe/Center/Row/Panel/Content/Feedback/Message
+@onready var _counter: Label = $Safe/Center/Row/Panel/Content/Feedback/Counter
+@onready var _go: Button = $Safe/Center/Row/Panel/Content/GoButton
+@onready var _hint: Label = $Safe/Center/Row/Panel/Content/Hint
+
+
+func _ready() -> void:
+	$Safe/Center/Row/Art/GameTitle.text = GameInfo.TITLE
+	LevelCatalog.apply_sound()
+	_edit.text_changed.connect(_on_text_changed)
+	_edit.text_submitted.connect(_on_submitted)
+	_go.pressed.connect(_on_go_pressed)
+	var profile: Dictionary = PlayerProfile.local()
+	_edit.text = str(profile["nickname"])
+	_on_text_changed(_edit.text)
+	if bool(profile["nicknameConflict"]):
+		_show("Имя «%s» уже занято — выбери другое" % profile["nickname"], ERROR_COLOR)
+	_apply_safe_area()
+	if not OS.has_feature("mobile"):
+		_edit.grab_focus.call_deferred()
+
+
+func _process(_delta: float) -> void:
+	# Landscape keyboards cover half the screen: keep the field above it.
+	var keyboard: float = ScreenUtil.keyboard_height(get_viewport())
+	var compact: bool = keyboard > 0.0
+	_art.visible = not compact
+	_subtitle.visible = not compact
+	_hint.visible = not compact
+	var margins: Vector4 = ScreenUtil.safe_margins(get_viewport())
+	_safe.add_theme_constant_override("margin_bottom", int(maxf(margins.w, keyboard)))
+
+
+func _notification(what: int) -> void:
+	if what == NOTIFICATION_WM_GO_BACK_REQUEST:
+		if _busy:
+			return
+		if Onboarding.rename_mode:
+			_leave_to_map()
+		else:
+			get_tree().quit()  # first launch: a name is needed to go on
+
+
+## Current text as the player typed it (tests and screenshots set it here).
+func set_text(text: String) -> void:
+	_edit.text = text
+	_on_text_changed(text)
+
+
+func submit() -> void:
+	_on_go_pressed()
+
+
+func _apply_safe_area() -> void:
+	var margins: Vector4 = ScreenUtil.safe_margins(get_viewport())
+	_safe.add_theme_constant_override("margin_left", int(margins.x) + 16)
+	_safe.add_theme_constant_override("margin_top", int(margins.y) + 8)
+	_safe.add_theme_constant_override("margin_right", int(margins.z) + 16)
+
+
+func _on_text_changed(text: String) -> void:
+	if _saved_offline:
+		_saved_offline = false
+		_go.text = "Вперёд!"
+	var check: Dictionary = NicknameRules.validate(text)
+	_counter.text = "%d/%d" % [NicknameRules.clean(text).length(), NicknameRules.MAX_LENGTH]
+	_counter.add_theme_color_override(
+		"font_color",
+		(
+			ERROR_COLOR
+			if NicknameRules.clean(text).length() > NicknameRules.MAX_LENGTH
+			else NEUTRAL_COLOR
+		)
+	)
+	if text.strip_edges() == "":
+		_show(DEFAULT_HINT, NEUTRAL_COLOR)
+	elif check["ok"]:
+		_show("Отличное имя!", OK_COLOR)
+	elif check["error"] == "too_short" and not _tried:
+		_show(str(check["message"]), NEUTRAL_COLOR)  # still typing
+	else:
+		_show(str(check["message"]), ERROR_COLOR)
+	_go.disabled = _busy or not check["ok"]
+
+
+func _on_submitted(_text: String) -> void:
+	_on_go_pressed()
+
+
+func _on_go_pressed() -> void:
+	if _busy:
+		return
+	if _saved_offline:
+		_finish()
+		return
+	_tried = true
+	var check: Dictionary = NicknameRules.validate(_edit.text)
+	if not check["ok"]:
+		_on_text_changed(_edit.text)
+		return
+	_set_busy(true)
+	_show("Проверяем имя…", INFO_COLOR)
+	var result: Dictionary = await Online.reserve_nickname(_edit.text)
+	_set_busy(false)
+	match str(result["reason"]):
+		"reserved", "local":
+			_edit.text = str(PlayerProfile.local()["nickname"])
+			_show("Приятно познакомиться, %s!" % _edit.text, OK_COLOR)
+			_set_busy(true)  # no second submit while we move on
+			await get_tree().create_timer(SUCCESS_PAUSE).timeout
+			_finish()
+		"offline":
+			_saved_offline = true
+			_go.text = "Продолжить"
+			_go.disabled = false
